---
import { news } from "../data/content";
---

<section id="noticias" data-screen-label="Noticias" class="news">
  <div class="intro">
    <span class="kicker">Actualidad</span>
    <h2>Noticias</h2>
  </div>
  {news.length > 0 ? (
    <div class="grid">
      {news.map((n) => (
        <a href={n.href} class="card">
          <span class="date">{n.date}</span>
          <h3>{n.title}</h3>
          <span class="read-more">Leer más →</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">Aún no hay noticias publicadas. Vuelve pronto.</p>
  )}
</section>

<style>
  .news {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--bg-alt);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--border-subtle);
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .date {
    font-size: 13px;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h3-sans-line);
  }

  .read-more {
    font-size: 14px;
    color: var(--primary);
    font-weight: 600;
  }

  .empty {
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    font-size: 15px;
    color: var(--ink-muted);
  }
</style>
