---
interface Props {
  wordmarkColor?: string;
  size?: number;
}

const { wordmarkColor = "var(--primary-dark)", size = 32 } = Astro.props;
---

<a href="#top" class="logo">
  <img src="/logo-mark.png" alt="" width={size} height={size} class="mark" />
  <span class="wordmark" style={`color:${wordmarkColor}`}>
    <span class="wordmark-line1">Encuentros</span>
    <span class="wordmark-line2">Siloé</span>
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    flex: none;
    display: block;
  }

  .wordmark {
    font-family: "Lora", serif;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .wordmark-line1 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .wordmark-line2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>
