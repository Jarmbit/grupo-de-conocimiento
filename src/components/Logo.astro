---
interface Props {
  color?: string;
  wordmarkColor?: string;
  size?: "default" | "small";
}

const { color = "var(--navy)", wordmarkColor = "var(--navy-dark)", size = "default" } = Astro.props;
---

<a href="#top" class="logo">
  <span class="symbol" style={`--symbol-color:${color}`}></span>
  <span class="wordmark" style={`color:${wordmarkColor}`}>Grupo de Conocimiento</span>
</a>

<style define:vars={{ size }}>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .symbol {
    position: relative;
    width: 22px;
    height: 28px;
    flex: none;
    display: inline-block;
  }

  .symbol::before,
  .symbol::after {
    content: "";
    position: absolute;
    background: var(--symbol-color);
    border-radius: 1px;
  }

  .symbol::before {
    left: 9px;
    top: 0;
    width: 4px;
    height: 28px;
  }

  .symbol::after {
    left: 2px;
    top: 7px;
    width: 18px;
    height: 4px;
  }

  .wordmark {
    font-family: "Lora", serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
