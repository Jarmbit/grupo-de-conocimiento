---
import LogoMark from "./icons/LogoMark.astro";

interface Props {
  wordmarkColor?: string;
  crossColor?: string;
  pathColor?: string;
  size?: number;
}

const {
  wordmarkColor = "var(--primary-dark)",
  crossColor = "var(--primary-dark)",
  pathColor = "var(--secondary)",
  size = 32,
} = Astro.props;
---

<a href="#top" class="logo">
  <LogoMark size={size} crossColor={crossColor} pathColor={pathColor} />
  <span class="wordmark" style={`color:${wordmarkColor}`}>
    <span class="wordmark-line1">Encuentros</span>
    <span class="wordmark-line2">Siloé</span>
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wordmark {
    font-family: "Lora", serif;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .wordmark-line1 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .wordmark-line2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>
