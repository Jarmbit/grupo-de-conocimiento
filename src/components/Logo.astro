---
interface Props {
  wordmarkColor?: string;
  wordmarkAccentColor?: string;
  variant?: "navy" | "white";
  size?: number;
}

const {
  wordmarkColor = "var(--primary-dark)",
  wordmarkAccentColor = "var(--secondary)",
  variant = "navy",
  size = 32,
} = Astro.props;
const markSrc = variant === "white" ? "/logo-mark-white.png" : "/logo-mark-navy.png";
---

<a href="#top" class="logo">
  <img src={markSrc} alt="" width={size} height={size * 1.05} class="mark" />
  <span class="wordmark" style={`color:${wordmarkColor}`}>
    <span class="wordmark-line1">Encuentros</span>
    <span class="wordmark-line2" style={`color:${wordmarkAccentColor}`}>Siloé</span>
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    flex: none;
    display: block;
    object-fit: contain;
  }

  .wordmark {
    font-family: "Lora", serif;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .wordmark-line1 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .wordmark-line2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>
