---
interface Props {
  wordmarkColor?: string;
  size?: number;
}

const { wordmarkColor = "var(--navy-dark)", size = 32 } = Astro.props;
---

<a href="#top" class="logo">
  <img src="/logo-mark.png" alt="" width={size} height={size} class="mark" />
  <span class="wordmark" style={`color:${wordmarkColor}`}>Grupo de Conocimiento</span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    flex: none;
    display: block;
  }

  .wordmark {
    font-family: "Lora", serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
