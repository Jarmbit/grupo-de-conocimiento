---
import LogoMark from "./icons/LogoMark.astro";

interface Props {
  wordmarkColor?: string;
  size?: number;
}

const { wordmarkColor = "var(--navy-dark)", size = 30 } = Astro.props;
const gradientId = `gc-logo-gradient-${Math.random().toString(36).slice(2, 8)}`;
---

<a href="#top" class="logo">
  <LogoMark size={size} gradientId={gradientId} />
  <span class="wordmark" style={`color:${wordmarkColor}`}>Grupo de Conocimiento</span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wordmark {
    font-family: "Lora", serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
