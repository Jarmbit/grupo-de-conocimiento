---
import ContactForm from "./ContactForm.astro";

interface Props {
  id: string;
  kicker: string;
  title: string;
  intro: string;
  /** A qué bandeja va el formulario (pestaña «Solicitudes» de la hoja de la asociación). */
  tipo: "pide-un-encuentro" | "voluntariado" | "continuidad" | "habla-con-nosotros";
  /** Texto inicial del mensaje. */
  prefill?: string;
}

const { id, kicker, title, intro, tipo, prefill = "" } = Astro.props;
---

<section id={id} data-screen-label={kicker} class="lead">
  <div class="intro">
    <span class="kicker">{kicker}</span>
    <h2>{title}</h2>
    <p>{intro}</p>
  </div>

  <slot />

  <ContactForm tipo={tipo} prefill={prefill} />
</section>

<style is:global>
  /* El formulario queda bloqueado hasta que se completen los datos obligatorios de la página. */
  [data-lead-form].lead-locked {
    opacity: 0.45;
  }
</style>

<style>
  .lead {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 760px;
    margin: 0 auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }
</style>
