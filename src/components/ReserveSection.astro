---
import { contact } from "../data/content";
---

<section id="reservar" data-screen-label="Reservar plaza" class="reserve">
  <div class="intro">
    <span class="kicker">Reservar plaza</span>
    <h2>Reserva tu plaza</h2>
    <p class="event-line" id="reserve-event" hidden>
      Encuentro: <strong id="reserve-event-name"></strong>
    </p>
    <p>
      Déjanos tus datos y te confirmaremos la plaza. Indica en el comentario a qué encuentro quieres
      venir y cuántas plazas necesitas.
    </p>
  </div>

  <div class="form">
    <div data-lead-form data-pk="pk_0qWzBZIIahKTIPIDtjTNQ5tmsrZIczFbxYKA2yQKqjg" data-country="ES"></div>
    <p class="fallback">
      ¿Prefieres escribirnos directamente? <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </div>
  <script is:inline src="https://storage.googleapis.com/sdk-os/prod/widgets/lead-form/latest/lead-form.js" defer></script>
</section>

<style>
  .reserve {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 760px;
    margin: 0 auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .event-line {
    color: var(--primary-dark);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px;
    background: var(--bg-alt);
    border-radius: var(--radius-card);
  }

  /* Estilo del formulario de Bewe (variables que lee el widget). */
  [data-lead-form] {
    --lead-form-primary: #1f3a5f;
    --lead-form-background: #edf0f3;
    --lead-form-text: #1c2530;
    --lead-form-border: #c9d2dc;
    --lead-form-font: "Source Sans 3", sans-serif;
  }

  .fallback {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .fallback a {
    text-decoration: underline;
    color: var(--primary);
  }
</style>

<script>
  // Lee ?encuentro=… , lo muestra y, si el widget lo permite, lo escribe en el campo Comentario.
  // El relleno es un extra: si Bewe cambia su widget y falla, el texto de arriba sigue pidiendo el dato.
  const encuentro = new URLSearchParams(location.search).get("encuentro")?.trim().slice(0, 120);
  if (encuentro) {
    const line = document.getElementById("reserve-event");
    const name = document.getElementById("reserve-event-name");
    if (line && name) {
      name.textContent = encuentro;
      line.hidden = false;
    }

    const text = `Reserva de plaza para: ${encuentro}. Número de plazas: `;
    const fill = () => {
      const root = document.querySelector("[data-lead-form]")?.shadowRoot;
      const area = root?.querySelector("textarea");
      if (!area) return false;
      if (!area.value) {
        const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, "value")?.set;
        setter?.call(area, text);
        area.dispatchEvent(new Event("input", { bubbles: true }));
      }
      return true;
    };
    let tries = 0;
    const timer = setInterval(() => {
      if (fill() || ++tries > 40) clearInterval(timer);
    }, 250);
  }
</script>
