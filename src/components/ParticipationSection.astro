---
import { participation, eventRequest } from "../data/content";
---

<section id="crearlo-juntos" data-screen-label="Crearlo juntos" class="participation">
  <div class="intro">
    <span class="kicker">{participation.kicker}</span>
    <h2>{participation.title}</h2>
    <p>{participation.intro}</p>
  </div>
  <div class="grid">
    {
      participation.ways.map((way) => (
        <div class={`card ${way.highlighted ? "highlighted" : ""}`}>
          <span class="icon" aria-hidden="true" />
          <h3>{way.title}</h3>
          <p>{way.text}</p>
        </div>
      ))
    }
  </div>
  <div class="cta-row">
    <a href="#pide-un-encuentro" class="btn-primary">{eventRequest.label}</a>
    <a href="/apoya" class="btn-secondary">Ver formas de colaborar →</a>
  </div>
</section>

<style>
  .participation {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 22px 16px;
    background: var(--bg-alt);
    border-radius: var(--radius-card);
    border: 1.5px solid transparent;
  }

  .card.highlighted {
    background: var(--white);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(230, 4, 139, 0.12);
  }

  .icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    line-height: var(--text-h3-sans-line);
    color: var(--primary-dark);
  }

  .card p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

</style>
