---
import { identity, objective, pillars } from "../data/content";
---

<section id="sobre" data-screen-label="Sobre nosotros" class="about">
  <div class="intro">
    <span class="kicker">{identity.kicker}</span>
    <h2>{identity.title}</h2>
    <p>{identity.intro}</p>
  </div>

  <blockquote class="quote">{identity.quote}</blockquote>

  <div class="objective">
    <p class="objective-title">{objective.title}</p>
    <div class="audiences">
      {
        objective.audiences.map((a) => (
          <div class="audience-card">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid">
    {
      pillars.map((pillar) => (
        <div class="card">
          <span class="icon" aria-hidden="true" />
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .about {
    padding: clamp(56px, 10vw, 110px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 56px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .quote {
    margin: 0;
    max-width: 760px;
    padding: 28px 32px;
    border-left: 3px solid var(--accent);
    background: var(--bg-alt);
    border-radius: 0 14px 14px 0;
    font-family: "Lora", serif;
    font-style: italic;
    font-size: 19px;
    line-height: 1.6;
    color: var(--primary-dark);
  }

  .objective {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .objective-title {
    max-width: 720px;
    font-family: "Lora", serif;
    font-size: 22px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .audiences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    background: var(--primary);
    border-radius: var(--radius-card);
  }

  .audience-card h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .audience-card p {
    font-size: 15px;
    line-height: 1.6;
    color: #dbe2ea;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: var(--bg-alt);
    border-radius: var(--radius-card);
  }

  .icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--primary);
    flex: none;
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    line-height: var(--text-h3-sans-line);
    color: var(--primary-dark);
  }

  .card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
