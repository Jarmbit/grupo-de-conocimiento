---
interface Props {
  size?: number;
  gradientId?: string;
}

const { size = 32, gradientId = "gc-logo-gradient" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Grupo de Conocimiento"
>
  <defs>
    <linearGradient id={gradientId} x1="8" y1="20" x2="92" y2="80" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#29B6E8"></stop>
      <stop offset="0.5" stop-color="#5B62E0"></stop>
      <stop offset="1" stop-color="#D6259B"></stop>
    </linearGradient>
  </defs>
  <!-- outer arc of the "G" -->
  <path
    d="M62 20 A32 32 0 1 0 62 80 A32 32 0 0 0 88 66 L88 58 L64 58"
    stroke={`url(#${gradientId})`}
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <!-- inner arc of the "G" -->
  <path
    d="M58 34 A18 18 0 1 0 58 66 A18 18 0 0 0 74 55 L74 51 L58 51"
    stroke={`url(#${gradientId})`}
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
