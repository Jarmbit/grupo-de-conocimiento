---
interface Props {
  size?: number;
  crossColor?: string;
  pathColor?: string;
}

const { size = 32, crossColor = "var(--primary-dark)", pathColor = "var(--secondary)" } = Astro.props;
---

<svg
  width={size}
  height={size * 1.15}
  viewBox="0 0 100 115"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Encuentros Siloé"
>
  <path
    d="M14 78 C 30 78, 34 66, 46 60 C 58 54, 62 50, 66 44"
    stroke={pathColor}
    stroke-width="4.5"
    stroke-linecap="round"
    fill="none"
  />
  <rect x="45" y="10" width="10" height="62" rx="3" fill={crossColor} />
  <rect x="27" y="30" width="46" height="10" rx="3" fill={crossColor} />
</svg>
