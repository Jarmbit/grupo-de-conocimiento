---
import { Image } from "astro:assets";
import { siloeStory } from "../data/content";
import jesusLoEncuentra from "../assets/siloe-story/jesus-lo-encuentra.jpg";
import loEnviaASiloe from "../assets/siloe-story/lo-envia-a-siloe.jpg";
import seLavaYVuelveViendo from "../assets/siloe-story/se-lava-y-vuelve-viendo.jpg";
import bridgeJesusLosTrae from "../assets/siloe-story/bridge-jesus-los-trae.jpg";
import bridgeEncuentrosSiloe from "../assets/siloe-story/bridge-encuentros-siloe.jpg";
import bridgeSalenViendo from "../assets/siloe-story/bridge-salen-viendo.jpg";

const stepImages = [jesusLoEncuentra, loEnviaASiloe, seLavaYVuelveViendo];
---

<section id="origen-del-nombre" data-screen-label="El origen del nombre" class="siloe-story">
  <div class="intro">
    <span class="kicker">{siloeStory.kicker}</span>
    <h2>{siloeStory.title}</h2>
    <span class="verse">({siloeStory.verse})</span>
  </div>

  <div class="steps">
    {
      siloeStory.steps.map((step, i) => (
        <div class="step">
          <Image
            src={stepImages[i]}
            alt={step.title}
            class="step-photo"
            width={160}
            height={160}
            loading="lazy"
          />
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))
    }
  </div>

  <p class="closing">{siloeStory.closing}</p>

  <div class="bridge">
    <div class="bridge-item">
      <Image
        src={bridgeJesusLosTrae}
        alt={`${siloeStory.bridge.before.title}: ${siloeStory.bridge.before.text}`}
        class="bridge-photo"
        width={340}
        height={256}
        loading="lazy"
      />
    </div>
    <span class="arrow">→</span>
    <div class="bridge-item bridge-highlight">
      <Image
        src={bridgeEncuentrosSiloe}
        alt={`${siloeStory.bridge.during.title}: ${siloeStory.bridge.during.text}`}
        class="bridge-photo"
        width={340}
        height={256}
        loading="lazy"
      />
    </div>
    <span class="arrow">→</span>
    <div class="bridge-item">
      <Image
        src={bridgeSalenViendo}
        alt={`${siloeStory.bridge.after.title}: ${siloeStory.bridge.after.text}`}
        class="bridge-photo"
        width={340}
        height={256}
        loading="lazy"
      />
    </div>
  </div>

  <p class="bridge-closing">{siloeStory.bridgeClosing}</p>
</section>

<style>
  .siloe-story {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--primary-dark);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--white);
    line-height: var(--text-h2-line);
  }

  .verse {
    font-size: 14px;
    color: var(--secondary);
    font-weight: 600;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 24px 18px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .step :global(.step-photo) {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 3px 10px rgba(91, 155, 213, 0.35);
    border: 2px solid rgba(255, 255, 255, 0.25);
  }

  .step h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
  }

  .step p {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .closing {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    font-family: "Lora", serif;
    font-style: italic;
    font-size: 17px;
    color: rgba(255, 255, 255, 0.9);
  }

  .bridge {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
  }

  @media (max-width: 640px) {
    .bridge {
      flex-direction: column;
    }
  }

  .bridge-item {
    flex: 1 1 200px;
    display: flex;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .bridge-highlight {
    border: 1px solid var(--secondary);
  }

  .bridge-item :global(.bridge-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(91, 155, 213, 0.12);
    color: var(--secondary);
    font-size: 16px;
    flex: 0 0 auto;
  }

  @media (max-width: 640px) {
    .arrow {
      transform: rotate(90deg);
    }
  }

  .bridge-closing {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
  }
</style>
