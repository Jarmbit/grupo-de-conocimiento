---
import { pastEvents } from "../data/content";
---

<section id="eventos-pasados" data-screen-label="Eventos pasados" class="past-events">
  <div class="intro">
    <span class="kicker">Así fueron</span>
    <h2>Encuentros ya celebrados</h2>
    <p>Un vistazo a algunos de los encuentros que ya hemos vivido junto a parroquias y comunidades.</p>
  </div>
  <div class="events">
    {
      pastEvents.map((event) => (
        <div class="event">
          <div class="event-header">
            <h3>{event.title}</h3>
            <span class="meta">{event.location} · {event.date}</span>
          </div>
          <div class="photos">
            {event.photos.map((photo, i) => (
              <button type="button" class="photo" data-lightbox-src={photo} aria-label={`Ver foto ${i + 1} de ${event.title}`}>
                <img src={photo} alt={`${event.title} — ${event.location}`} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<div id="past-events-lightbox" class="lightbox" hidden>
  <div class="lightbox-backdrop"></div>
  <div class="lightbox-content">
    <button type="button" class="lightbox-close" aria-label="Cerrar foto">✕</button>
    <img id="past-events-lightbox-img" src="" alt="" />
  </div>
</div>

<style>
  .past-events {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: 34px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .events {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .event-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 18px;
  }

  .event-header h3 {
    font-family: "Lora", serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .meta {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .photo {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-alt);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .photo:hover {
    opacity: 0.88;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 48px);
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 14, 26, 0.9);
  }

  .lightbox-content {
    position: relative;
    max-width: 1100px;
    max-height: 90vh;
  }

  .lightbox-close {
    position: absolute;
    top: -42px;
    right: 0;
    background: none;
    border: none;
    color: var(--white);
    font-size: 22px;
    cursor: pointer;
    padding: 6px 10px;
  }

  #past-events-lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 12px;
    display: block;
  }
</style>

<script>
  const lightbox = document.getElementById("past-events-lightbox") as HTMLDivElement | null;
  const lightboxImg = document.getElementById("past-events-lightbox-img") as HTMLImageElement | null;
  const closeBtn = lightbox?.querySelector(".lightbox-close");
  const backdrop = lightbox?.querySelector(".lightbox-backdrop");

  function openLightbox(src: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightbox.hidden = false;
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.removeAttribute("src");
  }

  document.querySelectorAll<HTMLButtonElement>(".past-events .photo").forEach((btn) => {
    btn.addEventListener("click", () => {
      const src = btn.dataset.lightboxSrc;
      if (src) openLightbox(src);
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  backdrop?.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>
