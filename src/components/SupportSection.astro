---
import { donationModels, highlightDonation, contact, bankAccount, membershipTiers, supportFaq } from "../data/content";

// Voluntariado va al formulario de contacto de Bewe; el resto de modalidades no pagadas, por email.
function supportHref(key: string, title: string) {
  if (key === "voluntariado") return "/voluntariado";
  if (key === "socio") return "#alta-socio";
  const subject = `Quiero informarme: ${title}`;
  const body = `Hola, quiero informarme sobre cómo colaborar como "${title}" con Encuentros Siloé.`;
  return `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

// Modalidades que se pagan con tarjeta (pago único). Socio mensual (recurrente) y voluntariado siguen por email.
const payKinds = ["puntual", "patrocinio"];
---

<section id="apoya" data-screen-label="Apoya" class="support">
  <div class="intro">
    <span class="kicker">Colabora</span>
    <h2>Apoya nuestra misión</h2>
    <p>Tu ayuda hace posible cada testimonio, cada vídeo y cada encuentro.</p>
  </div>
  <p class="tax-note">
    La Asociación Encuentros Siloé es una entidad de reciente constitución. Actualmente no está
    declarada de utilidad pública, por lo que las cuotas y donativos que recibe no dan derecho a
    deducción fiscal en el IRPF ni en el Impuesto sobre Sociedades. Solicitaremos la declaración de
    utilidad pública en cuanto cumplamos los requisitos legales para ello, momento en el que
    actualizaremos esta información.
  </p>
  <div class="grid">
    {
      donationModels.map((d) => (
        <div class={`card ${d.key === highlightDonation ? "highlighted" : ""}`}>
          <h3>{d.title}</h3>
          <span class="detail">{d.detail}</span>
          <p>{d.text}</p>
          {d.key === "socio" && (
            <ul class="tier-list">
              {membershipTiers.map((t) => (
                <li><span>{t.title}</span><b>{t.amount} €/mes</b></li>
              ))}
            </ul>
          )}
          <a
            href={payKinds.includes(d.key) ? `#pago-tarjeta` : supportHref(d.key, d.title)}
            data-pay-kind={payKinds.includes(d.key) ? d.key : undefined}
            class={d.key === highlightDonation ? "btn-primary" : "btn-primary-on-dark"}
          >
            {d.cta}
          </a>
        </div>
      ))
    }
  </div>

  <div class="methods" id="como-pagar">
    <h3>Cómo pagar</h3>
    <div class="methods-grid">
      <div class="method">
        <h4>Tarjeta — cuota mensual</h4>
        <p>Suscripción mensual segura para la cuota de socio, gestionada con Stripe.</p>
      </div>
      <div class="method">
        <h4>Tarjeta o Bizum — donativo puntual</h4>
        <p>Pago único con tarjeta en nuestro TPV virtual bancario (Redsys). Bizum estará disponible en cuanto lo confirme el banco.</p>
      </div>
      <div class="method">
        <h4>Transferencia</h4>
        <p>Disponible desde ahora, a nombre de la Asociación Encuentros Siloé.</p>
      </div>
    </div>
    <p class="pay-note">
      La cuota de socio necesita Stripe porque el TPV bancario no admite pagos recurrentes; el donativo
      puntual no requiere suscripción.
    </p>
  </div>

  <form id="alta-socio" class="pay member" novalidate>
    <h3>Hazte socio</h3>
    <p class="pay-note">Cuota mensual con tarjeta, por suscripción. Puedes darte de baja cuando quieras.</p>
    <fieldset class="tiers">
      <legend>Elige tu cuota</legend>
      {
        membershipTiers.map((t, i) => (
          <label class="tier">
            <input type="radio" name="tier" value={t.key} checked={i === 1} data-url={t.stripeUrl} data-label={`${t.title} (${t.amount} €/mes)`} />
            <span class="tier-body">
              <span class="tier-amt">{t.amount} €/mes</span>
              <span class="tier-name">{t.title}</span>
              <span class="tier-note">{t.note}</span>
            </span>
          </label>
        ))
      }
    </fieldset>
    <button type="submit" class="btn-primary-on-dark pay-submit">Suscribirme con tarjeta</button>
    <p class="pay-note" id="member-msg" role="status" hidden></p>
    <p class="pay-note">La Junta Directiva resolverá tu solicitud de alta como socio en su próxima reunión.</p>
  </form>

  <div class="benefits">
    <h3>Qué cambia según cómo colabores</h3>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Beneficio</th><th>Socio</th><th>Socio de honor</th><th>Colaborador / donante</th></tr>
        </thead>
        <tbody>
          <tr><td>Voz y voto en la Asamblea</td><td>✓</td><td>voz</td><td>—</td></tr>
          <tr><td>Elegible a la Junta Directiva</td><td>✓</td><td>—</td><td>—</td></tr>
          <tr><td>Boletín e información interna</td><td>✓</td><td>✓</td><td>general</td></tr>
          <tr><td>Plaza preferente en encuentros</td><td>✓</td><td>✓</td><td>—</td></tr>
          <tr><td>Cuota mensual</td><td>10 € / 20 € / 50 €</td><td>exenta</td><td>libre</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <form id="pago-tarjeta" class="pay" novalidate>
    <h3>Dona con tarjeta (donativo puntual)</h3>
    <p class="pay-note">Pago seguro mediante TPV virtual bancario (Redsys). No almacenamos los datos de tu tarjeta.</p>
    <label class="field">
      <span>Tu nombre *</span>
      <input type="text" name="name" autocomplete="name" maxlength="80" placeholder="Nombre y apellidos" required />
    </label>
    <label class="field">
      <span>Tu correo electrónico *</span>
      <input type="email" name="email" autocomplete="email" maxlength="120" placeholder="tu@correo.com" required />
    </label>
    <label class="field">
      <span>Teléfono (opcional)</span>
      <input type="tel" name="phone" autocomplete="tel" maxlength="30" placeholder="Para poder darte las gracias" />
    </label>
    <label class="field">
      <span>Tipo de aportación</span>
      <select name="kind">
        <option value="puntual">Donación puntual</option>
        <option value="patrocinio">Patrocinio de un encuentro</option>
      </select>
    </label>
    <div class="amounts" role="group" aria-label="Importe">
      {[10, 25, 50, 100].map((v) => <button type="button" class="amount" data-amount={v}>{v} €</button>)}
    </div>
    <label class="field">
      <span>Otro importe (€)</span>
      <input type="number" name="amount" min="1" max="5000" step="0.01" inputmode="decimal" placeholder="Ej. 30" required />
    </label>
    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>
        He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.
        Usaremos tus datos solo para agradecerte tu aportación.
      </span>
    </label>
    <button type="submit" class="btn-primary-on-dark pay-submit">Pagar con tarjeta</button>
    <p class="pay-error" role="alert" hidden></p>
  </form>

  <div class="pay" id="transferencia">
    <h3>Dona por transferencia</h3>
    <p class="pay-note">Haz una transferencia a nuestra cuenta desde tu banco.</p>
    <p class="pay-note">Titular: <strong>{bankAccount.holder}</strong></p>
    <div class="iban-row">
      <code class="iban" id="iban-value">{bankAccount.iban}</code>
      <button type="button" class="amount" id="copy-iban">Copiar IBAN</button>
    </div>
    <p class="pay-note">Concepto sugerido: <strong>{bankAccount.concept}</strong></p>
  </div>

  <div class="faq" id="preguntas">
    <h3>Preguntas frecuentes</h3>
    {
      supportFaq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-iban") as HTMLButtonElement | null;
  copyBtn?.addEventListener("click", async () => {
    const iban = (document.getElementById("iban-value")?.textContent ?? "").replace(/\s/g, "");
    try {
      await navigator.clipboard.writeText(iban);
      copyBtn.textContent = "¡Copiado!";
    } catch {
      copyBtn.textContent = "Selecciona y copia";
    }
    setTimeout(() => (copyBtn.textContent = "Copiar IBAN"), 2500);
  });

  // Alta de socio: lleva al Payment Link de Stripe del nivel elegido; sin enlace aún, pide la suscripción por email.
  const member = document.getElementById("alta-socio") as HTMLFormElement | null;
  member?.addEventListener("submit", (e) => {
    e.preventDefault();
    const sel = member.querySelector<HTMLInputElement>('input[name="tier"]:checked');
    const msg = document.getElementById("member-msg") as HTMLElement;
    if (!sel) return;
    const url = sel.dataset.url ?? "";
    if (url.startsWith("https://")) {
      window.location.href = url;
      return;
    }
    const subject = encodeURIComponent("Quiero hacerme socio");
    const body = encodeURIComponent(`Hola, quiero hacerme socio de Encuentros Siloé con la ${sel.dataset.label}. Mi nombre y teléfono:`);
    msg.hidden = false;
    msg.innerHTML = "";
    msg.append(
      "El pago por suscripción estará disponible en breve. Escríbenos y te avisamos en cuanto se active: ",
    );
    const a = document.createElement("a");
    a.href = `mailto:info@encuentrossiloe.org?subject=${subject}&body=${body}`;
    a.className = "inline-link";
    a.textContent = "info@encuentrossiloe.org";
    msg.append(a, ".");
  });

  const form = document.getElementById("pago-tarjeta") as HTMLFormElement | null;
  if (form) {
    const amountInput = form.elements.namedItem("amount") as HTMLInputElement;
    const kindSelect = form.elements.namedItem("kind") as HTMLSelectElement;
    const nameInput = form.elements.namedItem("name") as HTMLInputElement;
    const emailInput = form.elements.namedItem("email") as HTMLInputElement;
    const phoneInput = form.elements.namedItem("phone") as HTMLInputElement;
    const consentInput = form.elements.namedItem("consent") as HTMLInputElement;
    const errorEl = form.querySelector(".pay-error") as HTMLElement;
    const submitBtn = form.querySelector(".pay-submit") as HTMLButtonElement;

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
    };

    form.querySelectorAll<HTMLButtonElement>(".amount").forEach((b) =>
      b.addEventListener("click", () => {
        amountInput.value = b.dataset.amount ?? "";
        showError("");
      }),
    );

    document.querySelectorAll<HTMLElement>("[data-pay-kind]").forEach((a) =>
      a.addEventListener("click", () => {
        kindSelect.value = a.dataset.payKind ?? "puntual";
      }),
    );

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showError("");
      const amount = Number(amountInput.value.replace(",", "."));
      if (!Number.isFinite(amount) || amount < 1 || amount > 5000) {
        showError("Introduce un importe entre 1 y 5000 euros.");
        return;
      }
      if (nameInput.value.trim().length < 2) {
        showError("Escribe tu nombre para que podamos darte las gracias.");
        nameInput.focus();
        return;
      }
      if (!emailInput.validity.valid || !emailInput.value.trim()) {
        showError("Escribe un correo electrónico válido.");
        emailInput.focus();
        return;
      }
      if (!consentInput.checked) {
        showError("Debes aceptar la política de privacidad para continuar.");
        consentInput.focus();
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = "Conectando con el banco…";
      try {
        const res = await fetch("/api/redsys-create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            kind: kindSelect.value,
            amount,
            name: nameInput.value.trim(),
            email: emailInput.value.trim(),
            phone: phoneInput.value.trim(),
            consent: true,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "No se pudo iniciar el pago.");
        const f = document.createElement("form");
        f.method = "POST";
        f.action = data.url;
        for (const [name, value] of Object.entries<string>(data.fields)) {
          const i = document.createElement("input");
          i.type = "hidden";
          i.name = name;
          i.value = value;
          f.appendChild(i);
        }
        document.body.appendChild(f);
        f.submit();
      } catch (err) {
        showError(err instanceof Error ? err.message : "No se pudo iniciar el pago.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Pagar con tarjeta";
      }
    });
  }
</script>

<style>
  .support {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--primary);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--white);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: #c9d2dc;
    line-height: var(--text-body-line);
  }

  .tax-note {
    max-width: 760px;
    margin: 0 auto;
    padding: 14px 18px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.08);
    color: #c9d2dc;
    font-size: 14px;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    max-width: 1320px;
    margin: 0 auto;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card.highlighted {
    background: var(--white);
    border-color: var(--accent);
  }

  .card h3 {
    font-family: "Lora", serif;
    font-size: var(--text-h3-serif-size);
    font-weight: 600;
    line-height: var(--text-h3-serif-line);
    color: var(--primary-dark);
  }

  .detail {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .card p {
    font-size: 14px;
    color: var(--ink-muted);
    flex: 1;
  }

  .pay {
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--white);
  }

  .pay h3 {
    font-family: "Lora", serif;
    font-size: var(--text-h3-serif-size);
    font-weight: 600;
  }

  .iban-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .iban {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    overflow-wrap: anywhere;
  }

  .inline-link {
    text-decoration: underline;
  }

  .pay-note {
    font-size: 14px;
    color: #c9d2dc;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }

  .field select,
  .field input {
    font: inherit;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: var(--white);
    color: var(--ink);
  }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.45;
    color: #c9d2dc;
  }

  .consent input {
    flex: none;
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .consent a {
    text-decoration: underline;
    color: var(--white);
  }

  .amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .amount {
    font: inherit;
    font-weight: 600;
    padding: 10px 18px;
    min-height: 44px;
    border-radius: 100px;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  .amount:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .pay-submit {
    cursor: pointer;
    align-self: stretch;
    text-align: center;
  }

  .pay-submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .pay-error {
    font-size: 14px;
    color: #ffd2cc;
  }

  .tier-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tier-list li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .tier-list b {
    color: var(--primary-dark);
  }

  .methods,
  .benefits,
  .faq {
    max-width: 880px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--white);
  }

  .methods h3,
  .benefits h3,
  .faq h3,
  .member h3 {
    font-family: "Lora", serif;
    font-size: var(--text-h3-serif-size);
    font-weight: 600;
  }

  .methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .method {
    padding: 18px 20px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .method h4 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .method p {
    font-size: 13.5px;
    line-height: 1.5;
    color: #c9d2dc;
  }

  .tiers {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tiers legend {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .tier {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    cursor: pointer;
  }

  .tier:has(input:checked) {
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.1);
  }

  .tier input {
    flex: none;
    margin-top: 4px;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .tier-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tier-amt {
    font-family: "Lora", serif;
    font-size: 20px;
    font-weight: 600;
  }

  .tier-name {
    font-size: 14px;
    font-weight: 600;
  }

  .tier-note {
    font-size: 13px;
    color: #c9d2dc;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .benefits table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .benefits th,
  .benefits td {
    padding: 12px 16px;
    font-size: 14px;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }

  .benefits th {
    background: var(--primary-dark);
    color: var(--white);
    font-size: 13px;
  }

  .benefits td:first-child {
    font-weight: 700;
    color: var(--primary-dark);
  }

  .benefits tr:last-child td {
    border-bottom: none;
  }

  .faq details {
    padding: 16px 20px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .faq summary {
    font-weight: 600;
    cursor: pointer;
  }

  .faq details p {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #c9d2dc;
  }

  :global(.btn-primary),
  :global(.btn-primary-on-dark) {
    align-self: flex-start;
  }
</style>
