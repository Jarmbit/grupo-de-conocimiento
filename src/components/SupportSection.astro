---
import { donationModels, highlightDonation, contact } from "../data/content";

function supportHref(title: string) {
  const subject = `Quiero informarme: ${title}`;
  const body = `Hola, quiero informarme sobre cómo colaborar como "${title}" con Encuentros Siloé.`;
  return `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<section id="apoya" data-screen-label="Apoya" class="support">
  <div class="intro">
    <span class="kicker">Colabora</span>
    <h2>Apoya nuestra misión</h2>
    <p>Tu ayuda hace posible cada testimonio, cada vídeo y cada encuentro.</p>
  </div>
  <div class="grid">
    {
      donationModels.map((d) => (
        <div class={`card ${d.key === highlightDonation ? "highlighted" : ""}`}>
          <h3>{d.title}</h3>
          <span class="detail">{d.detail}</span>
          <p>{d.text}</p>
          {/* TODO: enlazar a una pasarela de pago real (Stripe, PayPal, TPV bancario) cuando esté disponible */}
          <a
            href={supportHref(d.title)}
            class={d.key === highlightDonation ? "btn-primary" : "btn-primary-on-dark"}
          >
            {d.cta}
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .support {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--primary);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--white);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: #c9d2dc;
    line-height: var(--text-body-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    max-width: 1320px;
    margin: 0 auto;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card.highlighted {
    background: var(--white);
    border-color: var(--accent);
  }

  .card h3 {
    font-family: "Lora", serif;
    font-size: var(--text-h3-serif-size);
    font-weight: 600;
    line-height: var(--text-h3-serif-line);
    color: var(--primary-dark);
  }

  .detail {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .card p {
    font-size: 14px;
    color: var(--ink-muted);
    flex: 1;
  }

  :global(.btn-primary),
  :global(.btn-primary-on-dark) {
    align-self: flex-start;
  }
</style>
