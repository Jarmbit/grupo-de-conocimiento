---
import { events } from "../data/content";
import { eventLabel } from "../data/eventLabel";

// Solo los encuentros que se reservan en esta web (los que tienen enlace propio no pasan por aquí).
const options = events.filter((e) => !e.link).map((e) => eventLabel(e));
const PLACES = Array.from({ length: 10 }, (_, i) => i + 1);
---

<div class="picker" id="reserve-picker">
  <div class="step">
    <label for="reserve-event">1. ¿A qué encuentro quieres venir?</label>
    <select id="reserve-event">
      <option value="">Elige el encuentro…</option>
      {options.map((o) => <option value={o}>{o}</option>)}
    </select>
  </div>
  <div class="step">
    <label for="reserve-places">2. ¿Cuántas plazas necesitas?</label>
    <select id="reserve-places">
      <option value="">Elige el número de plazas…</option>
      {PLACES.map((n) => <option value={String(n)}>{n} {n === 1 ? "plaza" : "plazas"}</option>)}
    </select>
    <span class="hint">Si sois más de 10, escríbenos a info@encuentrossiloe.org.</span>
  </div>
  <p class="status" id="reserve-status" role="status" aria-live="polite">
    Elige el encuentro y las plazas para poder enviar tus datos.
  </p>
</div>

<style>
  .picker {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px 28px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  select {
    font: inherit;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--border-subtle);
    background: var(--white);
    color: var(--ink);
    min-height: 46px;
  }

  select:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 1px;
  }

  .hint {
    font-size: 13px;
    color: var(--ink-muted);
  }

  .status {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .status.ok {
    color: var(--primary-dark);
    font-weight: 600;
  }

  .status.warn {
    color: #8a3b12;
  }
</style>

<script>
  import { setupLeadCompose } from "../scripts/leadCompose";

  const PREFIX = "Reserva de plaza para: ";
  const picker = document.getElementById("reserve-picker");

  if (picker) {
    const eventSel = document.getElementById("reserve-event") as HTMLSelectElement;
    const placesSel = document.getElementById("reserve-places") as HTMLSelectElement;
    const status = document.getElementById("reserve-status") as HTMLElement;
    const host = document.querySelector<HTMLElement>("[data-lead-form]");

    // Preselección desde ?encuentro=… (botón "Reservar plaza" de cada encuentro). También acepta
    // enlaces antiguos sin fecha, siempre que identifiquen un único encuentro.
    const param = new URLSearchParams(location.search).get("encuentro")?.trim().toLowerCase();
    if (param) {
      const opts = Array.from(eventSel.options).filter((o) => o.value);
      const exact = opts.find((o) => o.value.toLowerCase() === param);
      const partial = opts.filter((o) => o.value.toLowerCase().startsWith(param));
      const match = exact ?? (partial.length === 1 ? partial[0] : undefined);
      if (match) eventSel.value = match.value;
    }

    const lead = setupLeadCompose({
      host,
      ready: () => Boolean(eventSel.value && placesSel.value),
      header: () => `${PREFIX}${eventSel.value}. Número de plazas: ${placesSel.value}. `,
      stripFull: /^Reserva de plaza para:[\s\S]*?Número de plazas:\s*[^.]*\.?\s*/,
      onState: ({ ready, failOpen }) => {
        status.classList.toggle("ok", ready);
        status.classList.toggle("warn", failOpen && !ready);
        if (ready) {
          status.textContent = `Vas a reservar ${placesSel.value} ${placesSel.value === "1" ? "plaza" : "plazas"} para: ${eventSel.value}.`;
        } else if (failOpen) {
          status.textContent =
            "Indica en el comentario del formulario a qué encuentro quieres venir y cuántas plazas necesitas.";
        } else {
          status.textContent = "Elige el encuentro y las plazas para poder enviar tus datos.";
        }
      },
    });

    eventSel.addEventListener("change", lead.refresh);
    placesSel.addEventListener("change", lead.refresh);
  }
</script>
