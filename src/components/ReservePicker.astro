---
import { events } from "../data/content";
import { eventLabel } from "../data/eventLabel";
// Cada encuentro tiene su página de reserva propia (/reservar/<clave>). Este selector lleva a ella;
// los enlaces antiguos /reservar?encuentro=… redirigen directamente.
const options = events
  .filter((e) => !e.full && (e.reserveUrl || e.link))
  .map((e) => ({ label: eventLabel(e), url: (e.reserveUrl ?? e.link)! }));
---

<div class="picker" id="reserve-picker">
  <div class="step">
    <label for="reserve-event">¿A qué encuentro quieres venir?</label>
    <select id="reserve-event">
      <option value="">Elige el encuentro…</option>
      {options.map((o) => <option value={o.url} data-label={o.label}>{o.label}</option>)}
    </select>
  </div>
  <a class="btn" id="reserve-go" href="#" aria-disabled="true">Continuar</a>
  <p class="status">En el siguiente paso eliges las plazas y dejas tus datos. La confirmación te llega al momento por correo.</p>
</div>

<style>
  .picker {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px 28px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  select {
    font: inherit;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--border-subtle);
    background: var(--white);
    color: var(--ink);
    min-height: 46px;
  }

  select:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 1px;
  }

  .btn {
    align-self: flex-start;
    font-weight: 600;
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--primary);
    color: var(--white);
    text-decoration: none;
  }
  .btn[aria-disabled="true"] {
    opacity: 0.45;
    pointer-events: none;
  }

  .status {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .status.ok {
    color: var(--primary-dark);
    font-weight: 600;
  }

  .status.warn {
    color: #8a3b12;
  }
</style>

<script>
  const sel = document.getElementById("reserve-event") as HTMLSelectElement | null;
  const go = document.getElementById("reserve-go") as HTMLAnchorElement | null;
  if (sel && go) {
    const opts = Array.from(sel.options).filter((o) => o.value);
    // Enlaces antiguos: /reservar?encuentro=<encuentro · fecha> (también sin fecha si no es ambiguo).
    const param = new URLSearchParams(location.search).get("encuentro")?.trim().toLowerCase();
    if (param) {
      const label = (o: HTMLOptionElement) => (o.dataset.label ?? "").toLowerCase();
      const exact = opts.find((o) => label(o) === param);
      const partial = opts.filter((o) => label(o).startsWith(param));
      const match = exact ?? (partial.length === 1 ? partial[0] : undefined);
      if (match) location.replace(match.value);
    }
    const update = () => {
      go.href = sel.value || "#";
      go.setAttribute("aria-disabled", sel.value ? "false" : "true");
    };
    sel.addEventListener("change", update);
    update();
  }
</script>
