---
import { stories } from "../data/content";
---

<section id="historias" data-screen-label="Historias" class="stories">
  <div class="intro" data-reveal>
    <span class="kicker">Historias Siloé</span>
    <h2>Lo que va ocurriendo</h2>
    <p>Relatos, reflexiones y momentos de los encuentros que ya hemos vivido.</p>
  </div>

  <div class="grid">
    {stories.map((story, i) => (
      <a href={story.href} class="card" data-reveal style={`transition-delay:${i * 70}ms`}>
        <div class="media">
          {story.image ? (
            <img src={story.image} alt="" loading="lazy" />
          ) : (
            <div class="media-fallback" aria-hidden="true"></div>
          )}
          {story.placeholder && import.meta.env.DEV && <span class="badge">PLACEHOLDER</span>}
        </div>
        <div class="body">
          <span class="meta">
            <span class="category">{story.category}</span>
            <span class="dot" aria-hidden="true">·</span>
            <time>{story.date}</time>
          </span>
          <h3>{story.title}</h3>
          <p>{story.excerpt}</p>
          <span class="read-more">Leer más →</span>
        </div>
      </a>
    ))}
  </div>

  <a href="/historias" class="link-arrow link-arrow--block">Ver todas las historias →</a>
</section>

<style>
  .stories {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
    max-width: 1320px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    transition: transform 0.25s var(--ease-elegant), box-shadow 0.25s var(--ease-elegant);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgba(12, 31, 51, 0.1);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-primary-dark);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, var(--color-primary-dark), var(--color-primary));
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #8a4c2c;
    background: #f6e6d8;
    border-radius: 100px;
    padding: 3px 9px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 26px;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-secondary-text);
  }

  .dot {
    color: var(--border-subtle);
  }

  .body h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--primary-dark);
    line-height: 1.3;
  }

  .body p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
    flex: 1;
  }

  .read-more {
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
  }
</style>
