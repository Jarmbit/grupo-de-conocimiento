---
import { Image } from "astro:assets";
import splashImg from "../assets/splash-hero.jpg";
import { maintenanceMode } from "../data/content";
---

<div id="splash" class="splash" data-maintenance={maintenanceMode ? "true" : "false"}>
  <Image src={splashImg} alt="" class="splash-bg" widths={[480, 768, 1536]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="splash-overlay"></div>
  {maintenanceMode ? (
    <p class="splash-maintenance-note">Muy pronto.</p>
  ) : (
    <button type="button" id="splash-dismiss" class="splash-dismiss" aria-label="Continuar a la web">
      <span class="chevron"></span>
    </button>
  )}
</div>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .splash.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--primary-dark, #0f2138);
  }

  @media (max-aspect-ratio: 4/5) {
    .splash-bg {
      object-fit: contain;
    }
  }

  .splash-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(15, 33, 56, 0.15), rgba(15, 33, 56, 0.35));
  }

  .splash-dismiss {
    position: relative;
    margin-bottom: clamp(24px, 6vw, 56px);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    animation: bounce 2s ease-in-out infinite;
  }

  .chevron {
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--white);
    border-bottom: 2px solid var(--white);
    transform: rotate(45deg);
    margin-top: -4px;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-dismiss {
      animation: none;
    }
  }

  .splash-maintenance-note {
    position: relative;
    margin-bottom: clamp(32px, 8vw, 72px);
    font-family: "Lora", serif;
    font-style: italic;
    font-size: 18px;
    color: var(--white, #fff);
    text-align: center;
  }
</style>

<script>
  const splash = document.getElementById("splash");
  const isMaintenance = splash?.dataset.maintenance === "true";

  if (isMaintenance) {
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
  } else {
    const dismissBtn = document.getElementById("splash-dismiss");

    function hideSplash() {
      splash?.classList.add("is-hidden");
    }

    dismissBtn?.addEventListener("click", () => {
      document.getElementById("top")?.scrollIntoView({ behavior: "smooth" });
      hideSplash();
    });

    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY > 40) hideSplash();
      },
      { passive: true }
    );

    window.addEventListener("wheel", () => hideSplash(), { passive: true, once: true });
    window.addEventListener("touchmove", () => hideSplash(), { passive: true, once: true });
  }
</script>
