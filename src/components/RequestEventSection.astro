---
import { eventTypes, contact } from "../data/content";
---

<section id="pide-un-encuentro" data-screen-label="Pide un encuentro" class="request-event">
  <div class="intro">
    <span class="kicker">Pide un encuentro</span>
    <h2>Elige el encuentro que quieres traer a tu hogar o comunidad</h2>
    <p>Tenemos dos encuentros disponibles. Elige el que mejor encaje con las personas a las que quieres invitar.</p>
    <p class="privacy-note">
      Al escribirnos, tratamos tus datos según nuestra <a href="/privacidad">política de privacidad</a>.
    </p>
  </div>
  <div class="grid">
    {
      eventTypes.map((type) => {
        const mailtoHref = `mailto:${contact.email}?subject=${encodeURIComponent(type.requestSubject)}&body=${encodeURIComponent(type.requestBody)}`;
        return (
          <div class="card">
            <div class="media">
              {type.youtubeId ? (
                <button
                  type="button"
                  class="youtube-facade"
                  data-youtube-id={type.youtubeId}
                  data-youtube-title={`Trailer: ${type.title}`}
                  aria-label={`Reproducir trailer: ${type.title}`}
                >
                  <img
                    src={`https://i.ytimg.com/vi/${type.youtubeId}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                  />
                  <span class="play" aria-hidden="true">
                    <span class="triangle" />
                  </span>
                </button>
              ) : (
                <div class="placeholder">
                  <span>Trailer próximamente</span>
                </div>
              )}
            </div>
            <div class="body">
              <span class="type-kicker">{type.kicker}</span>
              <h3>{type.title}</h3>
              <p>{type.text}</p>
              <a href={mailtoHref} class="btn">Solicitar este encuentro →</a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .request-event {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .privacy-note {
    font-size: 13px;
  }

  .privacy-note a {
    color: var(--primary);
    font-weight: 600;
  }

  .privacy-note a:hover {
    color: var(--primary-dark);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-alt);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #1c3352;
  }

  .media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .youtube-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c3352;
  }

  .youtube-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .youtube-facade .play {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .youtube-facade .triangle {
    width: 0;
    height: 0;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
    border-left: 17px solid var(--white);
    margin-left: 5px;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      45deg,
      #1c3352,
      #1c3352 10px,
      #223c5e 10px,
      #223c5e 20px
    );
  }

  .placeholder span {
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(15, 33, 56, 0.6);
    padding: 8px 16px;
    border-radius: 100px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px 28px;
  }

  .type-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .body h3 {
    font-family: "Lora", serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .body p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .btn {
    align-self: flex-start;
    margin-top: 8px;
    background: var(--primary);
    color: var(--white);
    font-weight: 600;
    font-size: 15px;
    padding: 13px 24px;
    border-radius: 100px;
    transition: background 0.15s ease;
  }

  .btn:hover {
    background: var(--primary-dark);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".youtube-facade").forEach((facade) => {
    facade.addEventListener("click", () => {
      const videoId = facade.dataset.youtubeId;
      const title = facade.dataset.youtubeTitle ?? "";
      if (!videoId) return;

      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = title;
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.style.position = "absolute";
      iframe.style.inset = "0";
      iframe.style.width = "100%";
      iframe.style.height = "100%";
      iframe.style.border = "none";

      facade.replaceWith(iframe);
    });
  });
</script>
