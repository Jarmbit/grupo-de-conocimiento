---
import { eventTypes, contact } from "../data/content";
---

<section id="pide-un-encuentro" data-screen-label="Pide un encuentro" class="request-event">
  <div class="intro">
    <span class="kicker">Pide un encuentro</span>
    <h2>Elige el encuentro que quieres traer a tu hogar o comunidad</h2>
    <p>Tenemos dos encuentros disponibles. Elige el que mejor encaje con las personas a las que quieres invitar.</p>
    <p class="privacy-note">
      Al escribirnos, tratamos tus datos según nuestra <a href="/privacidad">política de privacidad</a>.
    </p>
  </div>
  <div class="grid">
    {
      eventTypes.map((type) => {
        const mailtoHref = `mailto:${contact.email}?subject=${encodeURIComponent(type.requestSubject)}&body=${encodeURIComponent(type.requestBody)}`;
        return (
          <div class="card">
            <div class="media">
              {type.youtubeId ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${type.youtubeId}`}
                  title={`Trailer: ${type.title}`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <div class="placeholder">
                  <span>Trailer próximamente</span>
                </div>
              )}
            </div>
            <div class="body">
              <span class="type-kicker">{type.kicker}</span>
              <h3>{type.title}</h3>
              <p>{type.text}</p>
              <a href={mailtoHref} class="btn">Solicitar este encuentro →</a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .request-event {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: 34px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .privacy-note {
    font-size: 13px;
  }

  .privacy-note a {
    color: var(--primary);
    font-weight: 600;
  }

  .privacy-note a:hover {
    color: var(--primary-dark);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-alt);
    border-radius: 16px;
    overflow: hidden;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #1c3352;
  }

  .media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      45deg,
      #1c3352,
      #1c3352 10px,
      #223c5e 10px,
      #223c5e 20px
    );
  }

  .placeholder span {
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(15, 33, 56, 0.6);
    padding: 8px 16px;
    border-radius: 100px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px 28px;
  }

  .type-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .body h3 {
    font-family: "Lora", serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .body p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .btn {
    align-self: flex-start;
    margin-top: 8px;
    background: var(--primary);
    color: var(--white);
    font-weight: 600;
    font-size: 15px;
    padding: 13px 24px;
    border-radius: 100px;
    transition: background 0.15s ease;
  }

  .btn:hover {
    background: var(--primary-dark);
  }
</style>
