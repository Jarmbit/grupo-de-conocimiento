---
import { videos } from "../data/content";
---

<section id="videos" data-screen-label="Vídeos" class="videos">
  <div class="intro">
    <span class="kicker">Vídeos</span>
    <h2>Momentos de nuestros encuentros</h2>
  </div>
  <div class="grid">
    {
      videos.map((v, i) => (
        <button type="button" class="card" data-video-src={v.src} data-video-title={v.title}>
          <div class="thumbnail">
            <img src={v.thumbnail} alt="" loading="lazy" />
            <span class="play">
              <span class="triangle" />
            </span>
            <span class="duration">{v.duration}</span>
          </div>
          <span class="title">{v.title}</span>
        </button>
      ))
    }
  </div>
</section>

<div id="video-modal" class="video-modal" hidden>
  <div class="video-modal-backdrop"></div>
  <div class="video-modal-content">
    <button type="button" class="video-modal-close" aria-label="Cerrar vídeo">✕</button>
    <video id="video-modal-player" controls playsinline></video>
  </div>
</div>

<style>
  .videos {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--primary-dark);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: 34px;
    font-weight: 600;
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    max-width: 1320px;
    margin: 0 auto;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: opacity 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
  }

  .card:hover {
    opacity: 0.92;
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c3352;
  }

  .thumbnail img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .triangle {
    width: 0;
    height: 0;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    border-left: 14px solid var(--white);
    margin-left: 4px;
  }

  .duration {
    position: absolute;
    bottom: 10px;
    right: 12px;
    font-size: 11px;
    color: var(--white);
    background: rgba(0, 0, 0, 0.5);
    padding: 2px 7px;
    border-radius: 5px;
  }

  .title {
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    line-height: 1.4;
  }

  .video-modal[hidden] {
    display: none;
  }

  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 48px);
  }

  .video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 14, 26, 0.9);
  }

  .video-modal-content {
    position: relative;
    width: 100%;
    max-width: 960px;
  }

  .video-modal-close {
    position: absolute;
    top: -42px;
    right: 0;
    background: none;
    border: none;
    color: var(--white);
    font-size: 22px;
    cursor: pointer;
    padding: 6px 10px;
  }

  #video-modal-player {
    width: 100%;
    max-height: 80vh;
    border-radius: 12px;
    display: block;
    background: black;
  }
</style>

<script>
  const modal = document.getElementById("video-modal") as HTMLDivElement | null;
  const player = document.getElementById("video-modal-player") as HTMLVideoElement | null;
  const closeBtn = modal?.querySelector(".video-modal-close");
  const backdrop = modal?.querySelector(".video-modal-backdrop");

  function openVideo(src: string) {
    if (!modal || !player) return;
    player.src = src;
    modal.hidden = false;
    player.play().catch(() => {});
  }

  function closeVideo() {
    if (!modal || !player) return;
    player.pause();
    player.removeAttribute("src");
    player.load();
    modal.hidden = true;
  }

  document.querySelectorAll<HTMLButtonElement>(".videos .card").forEach((card) => {
    card.addEventListener("click", () => {
      const src = card.dataset.videoSrc;
      if (src) openVideo(src);
    });
  });

  closeBtn?.addEventListener("click", closeVideo);
  backdrop?.addEventListener("click", closeVideo);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeVideo();
  });
</script>
