---
import { events } from "../data/content";
---

<section id="eventos" data-screen-label="Eventos" class="events-teaser">
  <div class="intro">
    <span class="kicker">Agenda</span>
    <h2>Próximos eventos</h2>
    {events.length > 0 ? (
      <p>Reserva tu plaza; el aforo es limitado.</p>
    ) : (
      <p>
        Estamos preparando los próximos encuentros. Si quieres que llevemos uno a tu parroquia u
        hogar, escríbenos.
      </p>
    )}
    <div class="cta-row">
      <a href="/eventos" class="btn-primary">Ver todos los eventos →</a>
      <a href="#pide-un-encuentro" class="link-arrow">¿Quieres que organicemos uno? Solicítalo →</a>
    </div>
  </div>
</section>

<style>
  .events-teaser {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  :global(.btn-primary) {
    flex: none;
  }
</style>
