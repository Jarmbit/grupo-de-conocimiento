<section id="apoya-teaser" data-screen-label="Apoya" class="support-teaser">
  <div class="intro">
    <span class="kicker">Colabora</span>
    <h2>Apoya nuestra misión</h2>
    <p>Tu ayuda hace posible cada testimonio, cada vídeo y cada encuentro.</p>
    <a href="/apoya" class="btn-primary-on-dark">Apoya nuestra misión →</a>
  </div>
</section>

<style>
  .support-teaser {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--primary);
  }

  .intro {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--white);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: #c9d2dc;
    line-height: var(--text-body-line);
  }

  :global(.btn-primary-on-dark) {
    align-self: center;
    margin-top: 8px;
  }
</style>
