---
import Logo from "./Logo.astro";
import { navLinks } from "../data/content";

const primaryNavLinks = navLinks.filter((link) => link.href !== "/apoya");
---

<header class="site-header">
  <Logo />
  <nav>
    {primaryNavLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="/apoya" class="btn-primary cta">Apóyanos</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px clamp(20px, 5vw, 48px);
    background: rgba(246, 247, 246, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 12px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    row-gap: 10px;
  }

  nav a {
    font-size: 15px;
    color: var(--ink-muted);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--primary);
  }

  :global(.cta) {
    font-size: 14px;
    padding: 10px 20px;
  }
</style>
