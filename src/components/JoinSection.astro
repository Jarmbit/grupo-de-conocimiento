---
import { socials, contact } from "../data/content";

const newsletterHref = `mailto:${contact.email}?subject=${encodeURIComponent("Quiero suscribirme al boletín")}&body=${encodeURIComponent("Hola, me gustaría suscribirme al boletín de Encuentros Siloé para recibir noticias, vídeos y próximos eventos.")}`;
---

<section id="unete" data-screen-label="Únete" class="join">
  <div class="intro">
    <span class="kicker">Comunidad</span>
    <h2>Mantente cerca</h2>
    <p>Recibe testimonios, avisos de eventos y contenido nuevo donde prefieras.</p>
  </div>
  <div class="grid">
    <div class="card">
      <span class="icon email"></span>
      <h3>Boletín por email</h3>
      <p>Un resumen mensual con noticias, vídeos y próximos eventos.</p>
      <a href={newsletterHref} class="btn">Suscribirme</a>
    </div>
  </div>
  {socials.length > 0 && (
    <div class="socials">
      <span class="socials-label">Síguenos también en:</span>
      {socials.map((s) => (
        <a href={s.href} class="social-icon" aria-label={s.label}>
          {s.initial}
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .join {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px;
    border-radius: 14px;
    background: var(--bg-alt);
  }

  .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .icon.email {
    background: var(--accent);
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    line-height: var(--text-h3-sans-line);
    color: var(--primary-dark);
  }

  .card p {
    font-size: 14px;
    color: var(--ink-muted);
    flex: 1;
  }

  .btn {
    align-self: flex-start;
    background: var(--primary);
    color: var(--white);
    font-weight: 600;
    font-size: 14px;
    padding: 11px 20px;
    border-radius: 100px;
    transition: background 0.15s ease;
  }

  .btn:hover {
    background: var(--primary-dark);
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-top: 8px;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .socials-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--primary-dark);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    transition: background 0.15s ease;
  }

  .social-icon:hover {
    background: var(--primary);
  }
</style>
