---
import SocialIcon from "./SocialIcon.astro";
import { socials, contact } from "../data/content";

const newsletterHref = `mailto:${contact.email}?subject=${encodeURIComponent("Quiero suscribirme al boletín")}&body=${encodeURIComponent("Hola, me gustaría suscribirme al boletín de Encuentros Siloé para recibir noticias, vídeos y próximos encuentros.")}`;
---

<section id="unete" data-screen-label="Únete" class="join">
  <div class="intro" data-reveal>
    <span class="kicker">Comunidad</span>
    <h2>Mantente cerca</h2>
    <p>Recibe testimonios, avisos de encuentros y contenido nuevo donde prefieras.</p>
  </div>
  <div class="grid">
    {socials.map((s) => (
      <div class="card">
        <span class="icon social" aria-hidden="true">
          <SocialIcon label={s.label} />
        </span>
        <h3>{s.label}</h3>
        <p>Síguenos y descubre por dentro cada encuentro.</p>
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Seguir en {s.label}
        </a>
      </div>
    ))}
    <div class="card">
      <span class="icon email"></span>
      <h3>Boletín por email</h3>
      <p>Un resumen mensual con noticias, vídeos y próximos encuentros.</p>
      <a href={newsletterHref} class="btn-primary">Suscribirme</a>
    </div>
  </div>
</section>

<style>
  .join {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px;
    border-radius: var(--radius-card);
    background: var(--bg-alt);
  }

  .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .icon.email {
    background: var(--accent);
  }

  .icon.social {
    background: var(--primary-dark);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon.social :global(svg) {
    width: 22px;
    height: 22px;
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    line-height: var(--text-h3-sans-line);
    color: var(--primary-dark);
  }

  .card p {
    font-size: 14px;
    color: var(--ink-muted);
    flex: 1;
  }

  :global(.btn-primary) {
    align-self: flex-start;
  }

  .btn:hover {
    background: var(--primary-dark);
  }
</style>
