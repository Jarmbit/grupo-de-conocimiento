---
// Alta en el boletín (sin Bewe): el formulario envía los datos a /api/boletin, que los guarda en la
// hoja de la asociación y manda el correo de bienvenida.
---

<section class="boletin" id="boletin">
  <div class="intro">
    <span class="kicker">Boletín</span>
    <h1>Suscríbete al boletín</h1>
    <p class="datos">Un resumen mensual con noticias, vídeos y próximos encuentros. Déjanos tu nombre y tu correo.</p>
  </div>

  <form id="boletin-form" class="form" novalidate>
    <label>Nombre
      <input name="nombre" required autocomplete="name" maxlength="80" />
    </label>
    <label>Correo electrónico
      <input name="email" type="email" required autocomplete="email" maxlength="120" />
    </label>
    <!-- Cebo anti-bots: oculto para las personas. -->
    <div class="cebo" aria-hidden="true">
      <label>Web <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label class="check">
      <input type="checkbox" name="consentimiento" required />
      <span>
        He leído la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> y consiento
        que Encuentros Siloé me envíe su boletín por correo. Puedo darme de baja cuando quiera.
      </span>
    </label>
    <button type="submit" class="btn" id="boletin-enviar">Suscribirme</button>
    <p class="msg" id="boletin-msg" role="status" aria-live="polite"></p>
  </form>

  <p class="fallback">
    ¿Prefieres escribirnos? <a href="mailto:info@encuentrossiloe.org">info@encuentrossiloe.org</a>
  </p>
</section>

<style>
  .boletin {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 640px;
    margin: 0 auto;
  }
  .intro { display: flex; flex-direction: column; gap: 12px; text-align: center; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; color: var(--accent-text); text-transform: uppercase; }
  h1 { font-family: "Lora", serif; font-size: var(--text-h2-size); font-weight: 600; color: var(--primary-dark); line-height: var(--text-h2-line); }
  .datos { color: var(--ink-muted); line-height: var(--text-body-line); }
  .aforo { font-weight: 600; color: var(--primary-dark); min-height: 1.4em; }
  .aforo.completo { color: #8a3b12; }
  .form { display: flex; flex-direction: column; gap: 18px; padding: 28px; background: var(--bg-alt); border-radius: var(--radius-card); }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 15px; font-weight: 600; color: var(--primary-dark); }
  .opt, .hint { font-weight: 400; font-size: 13px; color: var(--ink-muted); }
  input, select, textarea { font: inherit; padding: 12px 14px; border-radius: 10px; border: 1.5px solid var(--border-subtle); background: var(--white); color: var(--ink); min-height: 46px; font-weight: 400; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--secondary); outline-offset: 1px; }
  .check { flex-direction: row; align-items: flex-start; gap: 10px; font-weight: 400; font-size: 14px; color: var(--ink-muted); line-height: 1.45; }
  .check input { min-height: 0; width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .check a { color: var(--primary); text-decoration: underline; }
  .cebo { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .btn { font: inherit; font-weight: 600; padding: 14px 22px; border: 0; border-radius: 999px; background: var(--primary); color: var(--white); cursor: pointer; min-height: 48px; }
  .btn:disabled { opacity: 0.55; cursor: progress; }
  .msg { font-size: 15px; line-height: 1.45; color: var(--ink-muted); }
  .msg.ok { color: var(--primary-dark); font-weight: 600; }
  .msg.err { color: #8a3b12; }
  .fallback { text-align: center; font-size: 14px; color: var(--ink-muted); }
  .fallback a { color: var(--primary); text-decoration: underline; }
</style>

<script>
  import { medir } from "../scripts/medir";
  const form = document.getElementById("boletin-form") as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById("boletin-msg") as HTMLElement;
    const btn = document.getElementById("boletin-enviar") as HTMLButtonElement;
    const ERRORES: Record<string, string> = {
      email_invalido: "Revisa el correo electrónico.",
      nombre_invalido: "Indica tu nombre.",
      falta_consentimiento: "Necesitamos que aceptes la política de privacidad.",
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.className = "msg";
      const f = new FormData(form);
      const consentimiento = f.get("consentimiento") === "on";
      if (!form.reportValidity() || !consentimiento) {
        msg.classList.add("err");
        msg.textContent = consentimiento ? "Revisa los campos marcados." : ERRORES.falta_consentimiento;
        return;
      }
      btn.disabled = true;
      msg.textContent = "Enviando…";
      try {
        const res = await fetch("/api/boletin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nombre: f.get("nombre"), email: f.get("email"), website: f.get("website"), consentimiento }),
        });
        const d = await res.json().catch(() => ({}));
        if (d?.ok) {
          if (!d.yaSuscrito) medir("alta_boletin");
          msg.classList.add("ok");
          msg.textContent = d.yaSuscrito
            ? "Este correo ya estaba suscrito. ¡Gracias!"
            : "¡Listo! Te hemos enviado un correo de bienvenida. Si no lo ves, mira en spam.";
          form.reset();
        } else {
          msg.classList.add("err");
          msg.textContent = ERRORES[d?.error] ?? "No hemos podido completar la suscripción. Inténtalo de nuevo o escríbenos a info@encuentrossiloe.org.";
        }
      } catch {
        msg.classList.add("err");
        msg.textContent = "No hemos podido conectar. Inténtalo de nuevo o escríbenos a info@encuentrossiloe.org.";
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
