---
import Logo from "./Logo.astro";
import { navLinks, socials, contact } from "../data/content";
---

<footer id="contacto" data-screen-label="Contacto">
  <div class="columns">
    <div class="about">
      <Logo color="var(--gold)" wordmarkColor="var(--white)" />
      <p>
        Asociación sin ánimo de lucro. Damos a conocer a Dios a través de eventos, testimonios y
        vídeos, en comunión con las enseñanzas de la Iglesia.
      </p>
    </div>
    <div class="links">
      <span class="col-title">Explorar</span>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div class="contact">
      <span class="col-title">Contacto</span>
      <span class="contact-line">{contact.email}</span>
      <span class="contact-line">{contact.phone}</span>
      <div class="social-row">
        {
          socials.map((s) => (
            <a href={s.href} class="social-icon" aria-label={s.label}>
              {s.initial}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="bottom">
    <span class="copyright">© 2026 Grupo de Conocimiento. Asociación sin ánimo de lucro.</span>
    <div class="legal">
      <a href="#">Aviso legal</a>
      <a href="#">Privacidad</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: clamp(40px, 8vw, 64px) clamp(20px, 5vw, 64px) 40px;
    background: var(--navy-dark);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 340px;
  }

  .about p {
    font-size: 14px;
    line-height: 1.6;
    color: #9fadbc;
  }

  .links,
  .contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .links a {
    font-size: 14px;
    color: #9fadbc;
    transition: color 0.15s ease;
  }

  .links a:hover {
    color: var(--white);
  }

  .contact-line {
    font-size: 14px;
    color: #9fadbc;
  }

  .social-row {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  .social-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    transition: background 0.15s ease;
  }

  .social-icon:hover {
    background: var(--gold);
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 12px;
  }

  .copyright {
    font-size: 13px;
    color: #7c8aa0;
  }

  .legal {
    display: flex;
    gap: 20px;
  }

  .legal a {
    font-size: 13px;
    color: #7c8aa0;
    transition: color 0.15s ease;
  }

  .legal a:hover {
    color: var(--white);
  }
</style>
