---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={`${title} — Encuentros Siloé`} description={description}>
  <Header />
  <article class="legal">
    <h1>{title}</h1>
    <div class="content">
      <slot />
    </div>
  </article>
  <Footer />
</Layout>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 80px) clamp(20px, 5vw, 64px);
  }

  h1 {
    font-family: "Lora", serif;
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 600;
    color: var(--primary-dark);
    margin-bottom: 32px;
  }

  .content :global(h2) {
    font-family: "Lora", serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--primary-dark);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .content :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin-bottom: 14px;
  }

  .content :global(ul) {
    margin: 0 0 14px;
    padding-left: 20px;
  }

  .content :global(li) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }

  .content :global(strong) {
    color: var(--ink);
  }

  .content :global(mark) {
    background: #fde68a;
    padding: 0 4px;
    border-radius: 3px;
    font-weight: 600;
  }
</style>
