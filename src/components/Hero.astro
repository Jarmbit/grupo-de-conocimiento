---
import { identity } from "../data/content";
---

<section id="top" class="hero">
  <div class="content">
    <span class="kicker">Asociación sin ánimo de lucro</span>
    <h1>{identity.tagline}</h1>
    <p>
      Acompañamos a quienes buscan respuestas sobre la existencia de Dios y la vida de
      Jesucristo, a través de encuentros, testimonios y vídeos que unen fe y razón.
    </p>
    <div class="cta-row">
      <a href="#videos" class="btn btn-solid">Ver vídeos</a>
      <a href="#eventos" class="btn btn-outline">Próximos eventos</a>
    </div>
  </div>
  <div class="image">
    <img src="/images/evento-4.jpg" alt="Sala preparada para un encuentro de Encuentros Siloé" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    min-height: 640px;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
    padding: clamp(48px, 10vw, 80px) clamp(20px, 5vw, 64px);
    max-width: 640px;
    flex: 1 1 420px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h1 {
    font-family: "Lora", serif;
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1.12;
    font-weight: 600;
    color: var(--primary-dark);
  }

  p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .btn {
    font-weight: 600;
    font-size: 15px;
    padding: 14px 26px;
    border-radius: 100px;
    transition: background 0.15s ease;
  }

  .btn-solid {
    background: var(--primary);
    color: var(--white);
  }

  .btn-solid:hover {
    background: var(--primary-dark);
  }

  .btn-outline {
    background: transparent;
    color: var(--primary-dark);
    border: 1.5px solid var(--primary);
  }

  .btn-outline:hover {
    background: var(--bg-alt);
  }

  .image {
    position: relative;
    flex: 1 1 320px;
    min-height: 320px;
    overflow: hidden;
  }

  .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
