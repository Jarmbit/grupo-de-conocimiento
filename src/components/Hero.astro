---
import { Image } from "astro:assets";
import { identity } from "../data/content";
import eventoImg from "../assets/hero-encuentro.jpg";
---

<section id="top" class="hero">
  <div class="content">
    <span class="kicker">Asociación sin ánimo de lucro</span>
    <h1>{identity.tagline}</h1>
    <p>
      Acompañamos a quienes buscan respuestas sobre la existencia de Dios y la vida de
      Jesucristo, a través de encuentros, testimonios y vídeos que unen fe y razón.
    </p>
    <div class="cta-row">
      <a href="#pide-un-encuentro" class="btn-primary">Pide un encuentro</a>
      <a href="#videos" class="link-arrow link-arrow--block">Ver vídeos →</a>
    </div>
  </div>
  <div class="image">
    <Image
      src={eventoImg}
      alt="Encuentro de Encuentros Siloé con música en directo y numerosos asistentes"
      widths={[480, 768, 1200]}
      sizes="(max-width: 900px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    max-width: 1320px;
    margin: 0 auto;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
    padding: clamp(48px, 10vw, 80px) clamp(20px, 5vw, 64px);
    max-width: 560px;
    flex: 1 1 420px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h1 {
    font-family: "Lora", serif;
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1.12;
    font-weight: 600;
    color: var(--primary-dark);
    text-wrap: balance;
  }

  p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .cta-row :global(.btn-primary) {
    font-size: 16px;
    padding: 15px 28px;
  }

  .cta-row :global(.link-arrow) {
    font-size: 15px;
  }

  .image {
    position: relative;
    flex: 0 1 480px;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 440px;
    margin: 40px clamp(20px, 5vw, 64px);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .image {
      margin: 0 clamp(20px, 5vw, 64px) 40px;
    }
  }

  .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
