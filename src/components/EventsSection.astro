---
import { Image } from "astro:assets";
import { events, contact } from "../data/content";

const eventImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*.jpg",
  { eager: true }
);

function eventImage(path?: string) {
  if (!path) return undefined;
  const filename = path.split("/").pop();
  const entry = Object.entries(eventImages).find(([key]) => key.endsWith(`/${filename}`));
  return entry?.[1].default;
}

function reserveHref(title: string) {
  const subject = `Quiero reservar plaza: ${title}`;
  const body = `Hola, me gustaría reservar plaza para el encuentro "${title}". ¿Cómo sería el siguiente paso?`;
  return `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<section id="encuentros" data-screen-label="Encuentros" class="events">
  <div class="intro" data-reveal>
    <span class="kicker">Próximos encuentros</span>
    <h2>Quizá el próximo sea cerca de ti</h2>
    {events.length > 0 ? (
      <p>Reserva tu plaza; el aforo es limitado.</p>
    ) : (
      <p>
        Estamos preparando los próximos encuentros. Si quieres que llevemos uno a tu parroquia u
        hogar, escríbenos.
      </p>
    )}
    <p class="request">
      ¿Quieres que organicemos un encuentro en tu hogar o comunidad?
      <a href="/#pide-un-encuentro" class="link-arrow">Solicítalo aquí →</a>
    </p>
  </div>
  {events.length > 0 && (
    <div class="grid">
      {events.map((ev, i) => {
        const image = eventImage(ev.image);
        const href = ev.link ?? reserveHref(ev.title);
        const external = Boolean(ev.link);
        return (
          <article class="card" data-reveal style={`transition-delay:${Math.min(i, 4) * 70}ms`}>
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              class="card-media"
              aria-label={`Más información sobre ${ev.title}`}
            >
              {image ? (
                <Image
                  src={image}
                  alt={`Cartel del encuentro ${ev.title}`}
                  width={480}
                  height={600}
                  loading="lazy"
                />
              ) : (
                <div class="media-placeholder" aria-hidden="true">
                  <span class="placeholder-month">{ev.month}</span>
                  <span class="placeholder-day">{ev.day}</span>
                </div>
              )}
              <span class="date-badge">
                <span class="month">{ev.month}</span>
                <span class="day">{ev.day}</span>
              </span>
            </a>
            <div class="card-body">
              {ev.city && <span class="city">{ev.city}</span>}
              <h3>{ev.title}</h3>
              <p class="location">{ev.location}</p>
              {ev.description && <p class="description">{ev.description}</p>}
              {ev.spots && <span class="spots">{ev.spots}</span>}
              <a
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="btn-primary"
              >
                Reservar mi plaza
              </a>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>

<style>
  .events {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 1320px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .intro .request {
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition: transform 0.25s var(--ease-elegant), box-shadow 0.25s var(--ease-elegant);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgba(12, 31, 51, 0.12);
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--color-primary-dark);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-elegant);
  }

  .card:hover .card-media :global(img) {
    transform: scale(1.03);
  }

  .media-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: linear-gradient(160deg, var(--color-primary-dark), var(--color-primary));
    color: var(--white);
  }

  .placeholder-month {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .placeholder-day {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 600;
  }

  .date-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: rgba(247, 245, 240, 0.95);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .date-badge .month {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .date-badge .day {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 26px;
    flex: 1;
  }

  .city {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary-text);
  }

  .card-body h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--primary-dark);
    line-height: 1.25;
  }

  .location {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .description {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .spots {
    font-size: 13px;
    color: var(--accent-text);
    font-weight: 600;
  }

  .card-body :global(.btn-primary) {
    margin-top: 10px;
    align-self: flex-start;
    width: 100%;
    text-align: center;
  }
</style>
