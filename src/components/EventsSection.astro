---
import { Image } from "astro:assets";
import { events, showEventSpots, contact } from "../data/content";

const eventImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*.jpg",
  { eager: true }
);

function eventImage(path?: string) {
  if (!path) return undefined;
  const filename = path.split("/").pop();
  const entry = Object.entries(eventImages).find(([key]) => key.endsWith(`/${filename}`));
  return entry?.[1].default;
}

function reserveHref(title: string) {
  const subject = `Quiero reservar plaza: ${title}`;
  const body = `Hola, me gustaría reservar plaza para el evento "${title}". ¿Cómo sería el siguiente paso?`;
  return `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<section id="eventos" data-screen-label="Eventos" class="events">
  <div class="intro">
    <span class="kicker">Agenda</span>
    <h2>Próximos eventos</h2>
    {events.length > 0 ? (
      <p>Reserva tu plaza; el aforo es limitado.</p>
    ) : (
      <p>
        Estamos preparando los próximos encuentros. Si quieres que llevemos uno a tu parroquia u
        hogar, escríbenos.
      </p>
    )}
    <p class="request">
      ¿Quieres que organicemos un encuentro en tu hogar o comunidad?
      <a href="/#pide-un-encuentro" class="link-arrow">Solicítalo aquí →</a>
    </p>
  </div>
  {events.length > 0 && (
    <div class="list">
      {events.map((ev) => {
        const image = eventImage(ev.image);
        return (
          <div class="row">
            {image && (
              <a
                href={ev.link ?? reserveHref(ev.title)}
                target={ev.link ? "_blank" : undefined}
                rel={ev.link ? "noopener noreferrer" : undefined}
                class="poster-link"
                aria-label={`Más información sobre ${ev.title}`}
              >
                <Image src={image} alt={`Cartel del evento ${ev.title}`} class="poster" width={200} height={300} loading="lazy" />
              </a>
            )}
            <div class="date">
              <span class="month">{ev.month}</span>
              <span class="day">{ev.day}</span>
            </div>
            <div class="details">
              <h3>{ev.title}</h3>
              <span class="location">{ev.location}</span>
              {showEventSpots && <span class="spots">{ev.spots}</span>}
              <a href="/apoya" class="volunteer-link">¿Quieres ser voluntario en este evento?</a>
            </div>
            <a
              href={ev.link ?? reserveHref(ev.title)}
              target={ev.link ? "_blank" : undefined}
              rel={ev.link ? "noopener noreferrer" : undefined}
              class="btn-primary"
            >
              Reservar plaza
            </a>
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .events {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: var(--text-body-size);
    color: var(--ink-muted);
    line-height: var(--text-body-line);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    padding: 26px 28px;
    background: var(--bg-alt);
    border-radius: var(--radius-card);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      align-items: stretch;
    }

    .row .date {
      align-self: flex-start;
    }

    .row .poster-link {
      align-self: center;
    }

    .row :global(.btn-primary) {
      width: 100%;
      text-align: center;
    }
  }

  .poster-link {
    display: block;
    flex: none;
    border-radius: 10px;
    overflow: hidden;
  }

  .poster-link :global(.poster) {
    display: block;
    width: 100px;
    height: 150px;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.15s ease;
  }

  .poster-link:hover :global(.poster) {
    transform: scale(1.03);
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border-radius: 12px;
    padding: 12px 0;
    border: 1px solid var(--border-subtle);
    width: 100px;
    flex: none;
  }

  .month {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  .day {
    font-family: "Lora", serif;
    font-size: 26px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 200px;
  }

  .details h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--primary-dark);
  }

  .location {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .spots {
    font-size: 13px;
    color: var(--accent-text);
    font-weight: 600;
  }

  .volunteer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .volunteer-link:hover {
    color: var(--primary-dark);
  }

  :global(.btn-primary) {
    flex: none;
  }
</style>
