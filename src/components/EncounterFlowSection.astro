---
import { Image } from "astro:assets";
import { howWeDoIt, afterEncounter } from "../data/content";

const encuentroImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/encuentro/*.jpg",
  { eager: true }
);

function encuentroImage(path: string) {
  const filename = path.split("/").pop();
  const entry = Object.entries(encuentroImages).find(([key]) => key.endsWith(`/${filename}`));
  return entry?.[1].default;
}
---

<section id="como-es-un-encuentro" data-screen-label="Cómo es un encuentro" class="flow">
  <div class="intro">
    <span class="kicker">{howWeDoIt.kicker}</span>
    <h2>{howWeDoIt.title}</h2>
    <p>{howWeDoIt.intro}</p>
  </div>
  <div class="grid">
    {
      howWeDoIt.traits.map((trait) => {
        const image = encuentroImage(trait.image);
        return (
          <div class="card">
            {image && <Image src={image} alt={trait.alt} class="photo" width={64} height={64} loading="lazy" />}
            <h3>{trait.title}</h3>
            <p>{trait.text}</p>
          </div>
        );
      })
    }
  </div>
  <p class="closing">{howWeDoIt.closing}</p>

  <div id="y-despues-que" class="after">
    <div class="intro">
      <span class="kicker">{afterEncounter.kicker}</span>
      <h2>{afterEncounter.title}</h2>
      <p>{afterEncounter.intro}</p>
    </div>
    <div class="grid">
      {
        afterEncounter.ways.map((way) => (
          <div class="card">
            <span class="icon" aria-hidden="true" />
            <h3>{way.title}</h3>
            <p>{way.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .flow {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    background: var(--bg-alt);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 auto;
    text-align: center;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h2 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    font-weight: 600;
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }

  .intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 24px 18px;
    background: var(--white);
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
  }

  .photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    flex: none;
  }

  .card h3 {
    font-size: var(--text-h3-sans-size);
    font-weight: 600;
    line-height: var(--text-h3-sans-line);
    color: var(--primary-dark);
  }

  .card p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .closing {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    font-family: "Lora", serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.6;
    color: var(--primary-dark);
  }

  .after {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .after .icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--secondary);
    flex: none;
  }
</style>
