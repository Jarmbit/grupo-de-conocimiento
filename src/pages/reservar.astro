---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LeadFormSection from "../components/LeadFormSection.astro";
import ReservePicker from "../components/ReservePicker.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Reservar plaza — Encuentros Siloé"
  description="Reserva tu plaza en un encuentro de Encuentros Siloé. Elige el encuentro y las plazas, déjanos tus datos y te confirmaremos."
>
  <Header />
  <LeadFormSection
    id="reservar"
    kicker="Reservar plaza"
    title="Reserva tu plaza"
    intro="Elige el encuentro y cuántas plazas necesitas, déjanos tus datos y te confirmaremos la plaza."
  >
    <ReservePicker />
  </LeadFormSection>
  <Footer />
</Layout>
