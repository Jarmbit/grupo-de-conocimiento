---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ReservePicker from "../components/ReservePicker.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Reservar plaza — Encuentros Siloé"
  description="Reserva tu plaza en un encuentro de Encuentros Siloé. Elige el encuentro y las plazas, déjanos tus datos y recibirás la confirmación al momento."
>
  <Header />
  <section class="reservar" id="reservar" data-screen-label="Reservar plaza">
    <div class="intro">
      <span class="kicker">Reservar plaza</span>
      <h2>Reserva tu plaza</h2>
      <p>Elige el encuentro y te llevamos a su formulario de reserva.</p>
    </div>
    <ReservePicker />
  </section>
  <Footer />
</Layout>

<style>
  .reservar {
    padding: clamp(56px, 10vw, 100px) clamp(20px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 640px;
    margin: 0 auto;
  }
  .intro { display: flex; flex-direction: column; gap: 14px; text-align: center; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; color: var(--accent-text); text-transform: uppercase; }
  h2 { font-family: "Lora", serif; font-size: var(--text-h2-size); font-weight: 600; color: var(--primary-dark); line-height: var(--text-h2-line); }
  .intro p { font-size: var(--text-body-size); color: var(--ink-muted); line-height: var(--text-body-line); }
</style>
