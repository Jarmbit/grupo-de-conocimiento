---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { contact } from "../../data/content";
---

<Layout title="Pago realizado — Encuentros Siloé" description="Resultado de tu pago con tarjeta.">
  <Header />
  <main class="result">
    <h1>¡Gracias por tu aportación!</h1>
    <p>Hemos recibido tu pago. Tu ayuda hace posible cada testimonio, cada vídeo y cada encuentro. Que Dios te bendiga.</p>
    <p class="small">¿Dudas? Escríbenos a <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
    <div class="actions">
      <a href="/apoya" class="btn-primary">Volver a Apoya</a>
      <a href="/" class="btn-secondary">Ir al inicio</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .result {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(80px, 14vw, 140px) 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-align: center;
    align-items: center;
  }
  h1 {
    font-family: "Lora", serif;
    font-size: var(--text-h2-size);
    color: var(--primary-dark);
    line-height: var(--text-h2-line);
  }
  p {
    line-height: var(--text-body-line);
    color: var(--ink-muted);
  }
  .small a {
    color: var(--primary);
    text-decoration: underline;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>

<script>
  import { medir } from "../../scripts/medir";
  // Una vez por visita: recargar la página no cuenta un donativo nuevo. El aviso de cookies carga
  // la etiqueta al momento si ya estaban aceptadas; se espera un instante por si acaso.
  try {
    if (!sessionStorage.getItem("siloe-donativo-medido")) {
      setTimeout(() => {
        medir("donativo");
        sessionStorage.setItem("siloe-donativo-medido", "1");
      }, 500);
    }
  } catch {
    /* sin sessionStorage: no se mide */
  }
</script>
