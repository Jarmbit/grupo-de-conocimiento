---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LeadFormSection from "../components/LeadFormSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Boletín por email — Encuentros Siloé"
  description="Suscríbete al boletín de Encuentros Siloé: noticias, vídeos y próximos encuentros."
>
  <Header />
  <LeadFormSection
    id="boletin"
    kicker="Boletín"
    title="Suscríbete al boletín"
    intro="Un resumen mensual con noticias, vídeos y próximos encuentros. Déjanos tu nombre y tu correo."
    prefill="Quiero suscribirme al boletín de Encuentros Siloé."
  />
  <Footer />
</Layout>
