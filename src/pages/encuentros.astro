---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import RequestEventSection from "../components/RequestEventSection.astro";
import EventsSection from "../components/EventsSection.astro";
import PastEncountersSection from "../components/PastEncountersSection.astro";
import Footer from "../components/Footer.astro";
---

{/*
  TODO(SEO): añadir aquí datos estructurados Schema.org tipo Event cuando `EventItem` en
  content.ts tenga fecha/hora en formato ISO 8601 (startDate) — hoy solo existen como texto
  libre ("Torrelodones · 18:00h"), y generar JSON-LD con una fecha mal parseada es peor que no
  generarlo. En cuanto el dato sea estructurado, mapear cada `events` a:
  { "@type": "Event", name, startDate, location: { "@type": "Place", name, address }, ... }
*/}
<Layout
  title="Encuentros — Encuentros Siloé"
  description="Próximos encuentros de Encuentros Siloé: fechas, lugares y cómo reservar tu plaza. Descubre también cómo pedir un encuentro para tu hogar, parroquia o comunidad."
>
  <Header />
  <div class="page-spacer">
    <RequestEventSection />
    <EventsSection />
    <PastEncountersSection />
  </div>
  <Footer />
</Layout>

<style>
  .page-spacer {
    padding-top: 24px;
  }
</style>
