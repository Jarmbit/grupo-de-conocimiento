---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LeadFormSection from "../components/LeadFormSection.astro";
import RequestPicker from "../components/RequestPicker.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Pide un encuentro — Encuentros Siloé"
  description="Solicita un encuentro de Encuentros Siloé para tu hogar, comunidad o parroquia. Cuéntanos dónde y cuándo, déjanos tus datos y te contactaremos."
>
  <Header />
  <LeadFormSection
    id="pide-un-encuentro-formulario"
    kicker="Pide un encuentro"
    title="Solicita tu encuentro"
    intro="Cuéntanos qué encuentro quieres, dónde sería y cuántas personas, déjanos tus datos y te contactaremos."
  >
    <RequestPicker />
  </LeadFormSection>
  <Footer />
</Layout>
